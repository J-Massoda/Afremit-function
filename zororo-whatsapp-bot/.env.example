# ==============================================================================
# META WHATSAPP BUSINESS CLOUD API CREDENTIALS
# ==============================================================================
# 
# 🔍 WHERE TO FIND THESE VALUES:
# 1. Go to: https://developers.facebook.com/apps
# 2. Select your app → WhatsApp → Getting Started
# 3. Copy the values below from the Meta Business Dashboard
#
# ==============================================================================

# ✅ ACCESS TOKEN (Temporary - expires in 24 hours for testing)
# Location: WhatsApp → Getting Started → "Temporary access token"
# For production, generate a permanent System User Token
ACCESS_TOKEN=PASTE_META_ACCESS_TOKEN_HERE

# ✅ PHONE NUMBER ID (Your WhatsApp Business Phone Number ID)
# Location: WhatsApp → Getting Started → "Phone number ID"
# This is NOT your phone number - it's the unique identifier Meta assigns
PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID_HERE

# ✅ VERIFY TOKEN (Webhook verification - YOU create this)
# Location: YOU CREATE THIS - any random secret string
# Example: my_super_secret_verify_token_12345
# You'll paste this same value in Meta Dashboard → Webhooks → Verify Token
VERIFY_TOKEN=CREATE_ANY_RANDOM_SECRET_HERE

# ✅ WEBHOOK URL (Set after deploying or using ngrok)
# For local testing with ngrok: https://xxxx-xx-xxx-xxx-xx.ngrok-free.app/webhook
# For production: https://your-domain.com/webhook
# Copy this URL to: WhatsApp → Configuration → Webhooks → Callback URL

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=3000
NODE_ENV=development

